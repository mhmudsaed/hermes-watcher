# --- hermes-watcher: copy to .env and fill in (never commit real values) ---

# Telegram delivery (live mode). Leave empty to use the offline FakeSender
# (prints digest to stdout). See docs/TESTING.md for step-by-step setup.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Local SQLite database path (relative to repo root, or absolute).
WATCHER_DB=data/watcher.db

# Scoring profile (YAML). Default targets a remote-first AI/automation junior.
WATCHER_PROFILE=profiles/default.yaml

# Digest tuning.
WATCHER_MAX_ITEMS=15
WATCHER_THRESHOLD=3.0
# "status" = short "nothing new" line on quiet days; "silent" = send nothing.
WATCHER_EMPTY_MODE=status

# Comma-separated subset of: remoteok,weworkremotely,hn,remotive,arbeitnow,akhtaboot
# WATCHER_SOURCES=remoteok,weworkremotely,hn,remotive,arbeitnow,akhtaboot

# Politeness: seconds between feed requests; per-request HTTP timeout.
WATCHER_MIN_INTERVAL=2
WATCHER_HTTP_TIMEOUT=20
